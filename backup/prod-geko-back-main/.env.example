# Email (SMTP). For local, use console backend in settings or a dummy host.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change_me

# backup / restore folder name
SUBDOMAIN=default
