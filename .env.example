# GEKO production environment — copy this file to ".env" and replace every
# placeholder below. The real .env is git-ignored: never commit secrets.
#
#   cp .env.example .env
#
# Generate a secret key (Python 3):
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# (or any random string of at least 32 characters)
# Docker Compose expands "$VAR" even inside .env values, so drop "$" from
# the generated key (or escape every "$" as "$$") when you use compose.

# --- Django (backend) -------------------------------------------------------
# Production runs with DEBUG=False. With DEBUG=False the app refuses to
# start while SECRET_KEY is a placeholder or shorter than 32 characters,
# while ALLOWED_HOSTS is empty/"*", or while the DB password is a placeholder.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
# Comma-separated hostnames of the deployed site (no scheme, no port).
ALLOWED_HOSTS=localhost,127.0.0.1,example.com
# Browser origins allowed to call the API / submit admin forms (with scheme).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://example.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://example.com

# --- Postgres (db + backend) -------------------------------------------------
POSTGRES_DB=geko_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# --- Frontend build ----------------------------------------------------------
# Baked into the bundle at image build time (build arg, not runtime env).
# Leave empty so the browser calls /api on the same host. Required for a
# real domain and HTTPS. Set an absolute URL only if the API is elsewhere.
VITE_BASE_URL=

# Local development: set DEBUG=True in your .env and the placeholder checks
# above are skipped, so the defaults in backend/config/settings.py apply.
